      "topic": "version_control",
      "type": "multiple_choice",
      "presentation": "evidence_diff",
      "prompt": {
        "en": "Why is a visual Git diff useful during a security investigation?",
        "es": "Por qué es útil un diff visual de Git durante una investigación de seguridad?"
