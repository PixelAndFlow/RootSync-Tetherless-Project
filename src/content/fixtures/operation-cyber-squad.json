      "choices": [
        {
          "id": "A",
          "en": "Red Team / Grey Hat",
          "es": "Red Team / Grey Hat",
          "icon": "▲"
        },
        {
          "id": "B",
          "en": "Blue Team / White Hat",
          "es": "Blue Team / White Hat",
          "icon": "◆"
        },
        {
          "id": "C",
          "en": "GRC / Black Hat",
          "es": "GRC / Black Hat",
          "icon": "●"
        },
        {
          "id": "D",
          "en": "Red Team / Black Hat",
          "es": "Red Team / Black Hat",
          "icon": "■"
        }
      ],
      "correct_choice": "B",
      "feedback": {
        "en": "This is authorized defensive action.",
        "es": "Esta es una acción defensiva autorizada."
      }
