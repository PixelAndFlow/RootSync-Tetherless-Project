# Copy to .env and fill in. Never commit .env.
# Used by docker-compose.yml.

# Database password (required).
POSTGRES_PASSWORD=

# The app's permanent web address(es), comma-separated, allowed to call the API from a browser.
CORS_ORIGINS=

# Public domain for HTTPS (only with: docker compose --profile https up).
API_DOMAIN=
# Set to true when the API runs behind the HTTPS proxy.
TRUST_PROXY=

# Optional overrides (defaults: 8080, 70, 60, 30).
API_PORT=
PASS_PCT=
STRUGGLING_PCT=
IDLE_LIMIT_MINUTES=
