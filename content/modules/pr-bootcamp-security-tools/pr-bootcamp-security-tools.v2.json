      "prompt": {
        "en": "What principle guides IAM management?",
        "es": "¿En qué principio se basa la gestión IAM?"
      },
      "choices": [
        {
          "choice_id": "a",
          "text": {
            "en": "Least Privilege (Zero Trust)",
            "es": "Menor privilegio (Zero Trust)"
          }
        },
        {
          "choice_id": "b",
          "text": {
            "en": "Total access for everyone",
            "es": "Acceso total para todos"
          }
        },
        {
          "choice_id": "c",
          "text": {
            "en": "Public passwords",
            "es": "Contraseñas públicas"
          }
        },
        {
          "choice_id": "d",
          "text": {
