        {
          "id": "A",
          "en": "White Hat",
          "es": "White Hat",
          "icon": "▲"
        },
        {
          "id": "B",
          "en": "Authorized Red Team",
          "es": "Red Team autorizado",
          "icon": "◆"
        },
        {
          "id": "C",
          "en": "Unauthorized / Grey Hat",
          "es": "No autorizado / Grey Hat",
          "icon": "●"
        },
        {
          "id": "D",
          "en": "Blue Team",
          "es": "Blue Team",
          "icon": "■"
        }
