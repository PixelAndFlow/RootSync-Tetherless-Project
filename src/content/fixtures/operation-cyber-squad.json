      "choices": [
        {
          "id": "A",
          "en": "Blue Team",
          "es": "Blue Team / Equipo Azul",
          "icon": "▲"
        },
        {
          "id": "B",
          "en": "Red Team",
          "es": "Red Team / Equipo Rojo",
          "icon": "◆"
        },
        {
          "id": "C",
          "en": "GRC",
          "es": "GRC",
          "icon": "●"
        },
        {
          "id": "D",
          "en": "Sales",
          "es": "Ventas",
          "icon": "■"
        }
      ],
      "correct_choice": "A",
      "feedback": {
        "en": "Blue Teams are the defenders.",
        "es": "Los Blue Teams son los defensores."
      }
    },
    {
      "id": "q03",
      "topic": "team_roles",
      "type": "multiple_choice",
      "presentation": "kahoot_cards",
      "prompt": {
        "en": "Which group focuses on governance, risk, compliance, policies, and security rules?",
        "es": "Qué grupo se enfoca en gobernanza, riesgo, cumplimiento, políticas y reglas de seguridad?"
      },
      "choices": [
        {
          "id": "A",
          "en": "Red Team",
          "es": "Red Team / Equipo Rojo",
          "icon": "▲"
        },
        {
          "id": "B",
          "en": "Blue Team",
          "es": "Blue Team / Equipo Azul",
          "icon": "◆"
        },
        {
          "id": "C",
          "en": "GRC",
          "es": "GRC — Gobernanza, Riesgo y Cumplimiento",
          "icon": "●"
        },
        {
          "id": "D",
          "en": "Threat Actors",
          "es": "Actores de amenaza",
          "icon": "■"
        }
      ],
      "correct_choice": "C",
      "feedback": {
        "en": "GRC connects cybersecurity with governance, risk, compliance, and policy.",
        "es": "GRC conecta la ciberseguridad con gobernanza, riesgo, cumplimiento y políticas."
      }
    },
    {
      "id": "q04",
      "topic": "ethics",
      "type": "scenario_mc",
      "presentation": "mission_alert",
      "prompt": {
        "en": "What makes security testing authorized White Hat work?",
        "es": "Qué hace que una prueba de seguridad sea un trabajo autorizado de White Hat?"
      },
      "choices": [
        {
          "id": "A",
          "en": "Good intentions",
          "es": "Buenas intenciones",
          "icon": "▲"
        },
        {
          "id": "B",
          "en": "Written authorization and approved scope",
          "es": "Autorización escrita y alcance aprobado",
          "icon": "◆"
        },
        {
          "id": "C",
          "en": "Using free tools only",
          "es": "Usar solamente herramientas gratuitas",
          "icon": "●"
        },
        {
          "id": "D",
          "en": "Finding a real bug",
          "es": "Encontrar un error real",
          "icon": "■"
        }
      ],
      "correct_choice": "B",
      "feedback": {
        "en": "Written authorization and staying inside scope are essential.",
        "es": "La autorización escrita y mantenerse dentro del alcance son esenciales."
      }
    },
    {
      "id": "q05",
      "topic": "ethics",
      "type": "multiple_choice",
      "presentation": "kahoot_cards",
      "prompt": {
        "en": "What is the main purpose of Rules of Engagement (RoE)?",
        "es": "Cuál es el propósito principal de las Reglas de Enfrentamiento (RoE)?"
      },
      "choices": [
        {
          "id": "A",
          "en": "Choose the fastest tools",
          "es": "Elegir las herramientas más rápidas",
          "icon": "▲"
        },
        {
          "id": "B",
          "en": "Define approved targets, times, and actions",
          "es": "Definir objetivos, horarios y acciones aprobadas",
          "icon": "◆"
        },
        {
          "id": "C",
          "en": "Hide the test",
          "es": "Ocultar la prueba",
          "icon": "●"
        },
        {
          "id": "D",
          "en": "Guarantee no vulnerabilities exist",
          "es": "Garantizar que no existan vulnerabilidades",
          "icon": "■"
        }
      ],
      "correct_choice": "B",
      "feedback": {
        "en": "RoE defines the boundaries of a security assessment.",
        "es": "Las RoE definen los límites de una evaluación de seguridad."
      }
    },
