    {
      "question_id": "pr-bootcamp-security-tools-q01",
      "type": "multiple_choice",
      "topic": "firewalls",
      "term": {
        "en": "Firewall",
        "es": "Firewall"
      },
      "prompt": {
        "en": "What does a firewall do?",
        "es": "¿Qué hace un firewall (cortafuegos)?"
      },
      "choices": [
        {
          "choice_id": "a",
          "text": {
            "en": "Filters network traffic with rules",
            "es": "Filtra el tráfico de red con reglas"
          }
        },
        {
          "choice_id": "b",
          "text": {
            "en": "Generates complex passwords",
            "es": "Genera contraseñas complejas"
          }
        },
        {
          "choice_id": "c",
          "text": {
            "en": "Creates data backups",
            "es": "Crea copias de seguridad"
          }
        },
        {
          "choice_id": "d",
          "text": {
            "en": "Encrypts local storage",
            "es": "Cifra el almacenamiento local"
          }
        }
      ],
      "correct_choice_id": "a",
      "explanation": {
        "en": "A firewall checks network traffic against rules and blocks what isn't allowed.",
        "es": "Un firewall revisa el tráfico de red según reglas y bloquea lo que no está permitido."
      },
      "time_limit_sec": 60
    },
    {
      "question_id": "pr-bootcamp-security-tools-q02",
      "type": "multiple_choice",
      "topic": "firewalls",
      "term": {
        "en": "Next-gen firewall (NGFW)",
        "es": "Firewall de nueva generación (NGFW)"
