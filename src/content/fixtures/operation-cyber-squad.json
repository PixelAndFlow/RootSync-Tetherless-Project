      "topic": "ethics",
      "type": "scenario_mc",
      "presentation": "mission_alert",
      "prompt": {
        "en": "A game studio hires a security firm to test its app under a signed agreement. Which classification fits best?",
        "es": "Un estudio de videojuegos contrata a una firma de seguridad para probar su app bajo un acuerdo firmado. Qué clasificación encaja mejor?"
