      "choices": [
        {
          "id": "A",
          "en": "It hides old versions",
          "es": "Oculta versiones anteriores",
          "icon": "▲"
        },
        {
          "id": "B",
          "en": "It shows exactly what lines were added or removed",
          "es": "Muestra exactamente qué líneas fueron añadidas o eliminadas",
          "icon": "◆"
        },
        {
          "id": "C",
          "en": "It encrypts every file automatically",
          "es": "Cifra cada archivo automáticamente",
          "icon": "●"
        },
        {
          "id": "D",
          "en": "It blocks suspicious IP addresses",
          "es": "Bloquea direcciones IP sospechosas",
          "icon": "■"
        }
      ],
      "correct_choice": "B",
      "feedback": {
        "en": "A diff exposes exact line-level changes.",
        "es": "Un diff muestra cambios exactos por línea."
