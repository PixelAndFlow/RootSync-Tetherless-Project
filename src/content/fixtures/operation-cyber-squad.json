      "choices": [
        {
          "id": "A",
          "en": "Red Team / White Hat",
          "es": "Red Team / White Hat",
          "icon": "▲"
        },
        {
          "id": "B",
          "en": "Blue Team / Grey Hat",
          "es": "Blue Team / Grey Hat",
          "icon": "◆"
        },
        {
          "id": "C",
          "en": "GRC / Black Hat",
          "es": "GRC / Black Hat",
          "icon": "●"
