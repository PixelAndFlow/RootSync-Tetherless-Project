  "questions": [
    {
      "id": "q01",
      "topic": "team_roles",
      "type": "multiple_choice",
      "presentation": "kahoot_cards",
      "prompt": {
        "en": "Which cybersecurity team simulates attacks to find weaknesses before malicious attackers do?",
        "es": "Qué equipo de ciberseguridad simula ataques para encontrar debilidades antes que los atacantes maliciosos?"
      },
      "choices": [
        {
          "id": "A",
          "en": "Blue Team",
          "es": "Blue Team / Equipo Azul",
          "icon": "▲"
        },
        {
          "id": "B",
          "en": "Red Team",
          "es": "Red Team / Equipo Rojo",
          "icon": "◆"
        },
        {
          "id": "C",
          "en": "GRC",
          "es": "GRC",
          "icon": "●"
        },
        {
          "id": "D",
          "en": "Help Desk",
          "es": "Mesa de ayuda",
          "icon": "■"
        }
      ],
      "correct_choice": "B",
      "feedback": {
        "en": "Red Teams perform authorized offensive security testing.",
        "es": "Los Red Teams realizan pruebas ofensivas autorizadas."
      }
    },
    {
