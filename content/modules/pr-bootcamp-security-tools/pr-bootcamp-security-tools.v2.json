      "prompt": {
        "en": "What does an NGFW include?",
        "es": "¿Qué incluye un Firewall de Nueva Generación (NGFW)?"
      },
      "choices": [
        {
          "choice_id": "a",
          "text": {
            "en": "Basic antivirus only",
            "es": "Antivirus básico solamente"
          }
        },
        {
          "choice_id": "b",
          "text": {
            "en": "Deep packet inspection & detection",
            "es": "Inspección profunda de paquetes"
          }
        },
        {
          "choice_id": "c",
          "text": {
            "en": "Biometric authentication",
            "es": "Autenticación biométrica"
          }
        },
        {
          "choice_id": "d",
          "text": {
