      "type": "multiple_choice",
      "presentation": "kahoot_cards",
      "prompt": {
        "en": "Which team monitors systems, detects suspicious activity, and responds to attacks?",
        "es": "Qué equipo monitorea sistemas, detecta actividad sospechosa y responde a ataques?"
