      "type": "scenario_mc",
      "presentation": "security_alert",
      "prompt": {
        "en": "A school defender blocks an IP after thousands of failed password attempts. Which classification fits best?",
        "es": "Un defensor escolar bloquea una IP después de miles de intentos fallidos de contraseña. Qué clasificación encaja mejor?"
